# Copy to .env for local development. .env is gitignored.
#
# Or skip credentials entirely and run against FakeProvider:
#   MOTOROOTER_OFFLINE=1

MOTOROOTER_OFFLINE=1

# ORS_API_KEY=
# GOOGLE_MAPS_SERVER_KEY=          # server-side key, unrestricted by referrer
# OPENAI_API_KEY=

# Point at a self-hosted ORS to escape the free tier; quota and drag throttle relax to match.
# ORS_BASE_URL=http://localhost:8080/ors

# The Maps JS key is necessarily public. Restrict it by HTTP referrer and by API,
# and keep it distinct from GOOGLE_MAPS_SERVER_KEY.
# VITE_GOOGLE_MAPS_BROWSER_KEY=
