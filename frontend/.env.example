# Frontend build-time configuration.
#
# Copy to `frontend/.env.local` (gitignored) and fill in. Every VITE_* value is compiled
# into the bundle and is therefore public — never put a server-side key here.

# Maps JavaScript API browser key.
#
# Necessarily public, so it is protected by restriction rather than by secrecy: limit it to
# the Maps JavaScript API, and to the origins that may use it (http://localhost:5173/* for
# development, plus the Cloud Run origin). It must be a *different* key from the server-side
# Places key, which is not restricted this way and must never reach the browser.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Vector Map ID, from Google Cloud console -> Map Management.
#
# Needed for two things the app relies on: vector rendering, and AdvancedMarkerElement.
# Without one the map still loads, but waypoint pins fall back to plain markers and the
# canvas shows a notice saying so — clicking the map will appear to do nothing visible
# otherwise, since the styled pins never render.
VITE_GOOGLE_MAPS_MAP_ID=
