# Copy to frontend/.env.local (gitignored) for local development.
#
# Only VITE_-prefixed variables reach the browser bundle. That is deliberate: nothing
# server-side can leak in by accident.

# Maps JavaScript API key. Necessarily public — it ships in the bundle — so restrict it in
# the Cloud Console by HTTP referrer AND by API (Maps JavaScript API only). Keep it
# DISTINCT from GOOGLE_MAPS_SERVER_KEY, which is server-side and must never appear here.
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Required for Advanced Markers, which is how waypoint pins are drawn. Without it the
# basemap renders but no pin ever appears, and the only signal is a console warning.
# Create one under Cloud Console > Google Maps Platform > Map management.
VITE_GOOGLE_MAPS_MAP_ID=
